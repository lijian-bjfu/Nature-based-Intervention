// TreeScatterImporter.cs
// Put this file inside any folder named "Editor" in your Unity project.
// Opens via menu:  Tools > Tree Scatter Importer
//
// Reads a CSV exported from Houdini (columns: nx,nz,prototypeIndex,heightScale,widthScale,yaw)
// and plants the rows as Terrain Tree Instances on the assigned Terrain.
//
// Verified against Unity TreeInstance / TerrainData API:
//   - TreeInstance.position is NORMALIZED (0..1) across the terrain size
//   - TreeInstance.rotation is in RADIANS, around the Y axis only
//   - SetTreeInstances(instances, snapToHeightmap:true) drops each tree onto the surface

using UnityEngine;
using UnityEditor;
using System.Collections.Generic;
using System.Globalization;

public class TreeScatterImporter : EditorWindow
{
    public Terrain terrain;
    public TextAsset csvFile;                                       // the exported CSV (a TextAsset in your project)
    public List<GameObject> treePrefabs = new List<GameObject>();  // ORDER MUST MATCH prototypeIndex in the CSV

    [MenuItem("Tools/Tree Scatter Importer")]
    static void Open() => GetWindow<TreeScatterImporter>("Tree Scatter Importer");

    void OnGUI()
    {
        EditorGUILayout.HelpBox(
            "Prefab list order = prototypeIndex in the CSV.\n" +
            "Element 0 -> prototypeIndex 0, Element 1 -> 1, etc.\n" +
            "This must match the species->index mapping in your Houdini wrangle.",
            MessageType.Info);

        terrain = (Terrain)EditorGUILayout.ObjectField("Terrain", terrain, typeof(Terrain), true);
        csvFile = (TextAsset)EditorGUILayout.ObjectField("CSV File", csvFile, typeof(TextAsset), false);

        var so = new SerializedObject(this);
        EditorGUILayout.PropertyField(so.FindProperty("treePrefabs"), true);
        so.ApplyModifiedProperties();

        EditorGUILayout.Space();
        if (GUILayout.Button("Import Trees"))
            Import();

        if (GUILayout.Button("Clear All Trees On Terrain"))
        {
            if (terrain != null)
            {
                terrain.terrainData.SetTreeInstances(new TreeInstance[0], true);
                EditorUtility.SetDirty(terrain.terrainData);
                AssetDatabase.SaveAssets();
                Debug.Log("Cleared all tree instances.");
            }
        }
    }

    void Import()
    {
        if (terrain == null || csvFile == null || treePrefabs.Count == 0)
        {
            Debug.LogError("Assign a Terrain, a CSV file, and at least one tree prefab first.");
            return;
        }

        TerrainData data = terrain.terrainData;

        // 1) Register the prefabs as the terrain's TreePrototypes.
        //    Index in this array is exactly the prototypeIndex the CSV refers to.
        var protos = new TreePrototype[treePrefabs.Count];
        for (int i = 0; i < treePrefabs.Count; i++)
        {
            if (treePrefabs[i] == null)
            {
                Debug.LogError($"Tree prefab at index {i} is empty.");
                return;
            }
            protos[i] = new TreePrototype { prefab = treePrefabs[i] };
        }
        data.treePrototypes = protos;

        // 2) Parse the CSV into TreeInstances.
        var instances = new List<TreeInstance>();
        string[] lines = csvFile.text.Split('\n');
        int skipped = 0;

        for (int i = 1; i < lines.Length; i++)   // i = 1 skips the header row
        {
            string line = lines[i].Trim();
            if (string.IsNullOrEmpty(line)) continue;

            string[] c = line.Split(',');
            if (c.Length < 6) { skipped++; continue; }

            float nx  = float.Parse(c[0], CultureInfo.InvariantCulture);
            float nz  = float.Parse(c[1], CultureInfo.InvariantCulture);
            int   idx = int.Parse(c[2],   CultureInfo.InvariantCulture);
            float hs  = float.Parse(c[3], CultureInfo.InvariantCulture);
            float ws  = float.Parse(c[4], CultureInfo.InvariantCulture);
            float yaw = float.Parse(c[5], CultureInfo.InvariantCulture);

            if (idx < 0 || idx >= protos.Length) { skipped++; continue; }

            // ---- Axis / handedness note ----
            // Houdini and Unity differ in handedness. If the forest comes in mirrored,
            // flip one axis here, e.g.:  nx = 1f - nx;   or   nz = 1f - nz;
            // and if rotations look mirrored:  yaw = -yaw;

            instances.Add(new TreeInstance
            {
                position       = new Vector3(nx, 0f, nz), // normalized; Y is set by snapToHeightmap
                prototypeIndex = idx,
                heightScale    = hs,                       // multiplier on the prefab's authored size
                widthScale     = ws,
                rotation       = yaw,                      // radians, around Y
                color          = Color.white,
                lightmapColor  = Color.white
            });
        }

        // 3) Plant. snapToHeightmap:true drops each instance onto the terrain surface.
        data.SetTreeInstances(instances.ToArray(), true);
        EditorUtility.SetDirty(data);
        AssetDatabase.SaveAssets();

        Debug.Log($"Planted {instances.Count} trees on '{terrain.name}'. Skipped {skipped} rows.");
    }
}