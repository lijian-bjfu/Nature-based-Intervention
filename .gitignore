# 本机元数据与可重建缓存。
.DS_Store
__pycache__/
*.py[cod]
.cache/

# 每次运行的本地结果含源码/参数快照，不自动加入版本库。
analysis/**/outputs/
analysis/data_lab/history_index.csv

# 数据一律不入库（被试隐私与伦理要求）：只保留目录骨架与说明文件。
data/**
!data/**/
!data/**/README.md
!data/**/.gitkeep

# data_lab 的历史副本只存本机。
analysis/**/archive/

# data_lab 的结果只存本机：每个研究问题的 results/（最近一次）与 save/（研究者认可的结果）。
analysis/data_lab/**/results/
analysis/data_lab/**/save/

# 安全挪走的旧输出（retire_dir 生成），只存本机，由研究者人工删除。
**/_to_delete/

# 研究思路只存本机，不上传 GitHub
研究思路/
